# ============================================
# LupIA - Variables de entorno
# Copia este archivo a .env y llena los valores
# ============================================

# --- datos.gov.co (Socrata SODA API) ---
# Token de la aplicacion "LupIA" (el App Token publico, NO el secreto)
# Se crea en: https://www.datos.gov.co/profile/edit/developer_settings
SODA_APP_TOKEN=PEGA_AQUI_TU_APP_TOKEN
SODA_DOMAIN=www.datos.gov.co

# --- Datasets SECOP (verificados 2026-08-15) ---
DATASET_CONTRATOS=jbjy-vk9h
DATASET_PROCESOS=p6dx-8zbt
DATASET_PROVEEDORES=qmzu-gj57
DATASET_TIENDA_VIRTUAL=rgxm-mmea

# --- Parametros de la emergencia ---
FECHA_SISMO=2026-08-10T00:00:00
# Foco del monitor (UI y alertas priorizadas). El cache es nacional.
DEPARTAMENTOS_EMERGENCIA=Chocó,Risaralda,Quindío,Caldas,Valle del Cauca
# nacional = todo el pais (default) | emergencia = solo los 5 departamentos
AMBITO_INGESTA=nacional

# --- Base de datos ---
# Vacio = SQLite local (lupia.db). Con URL de Postgres se usa Postgres:
#   Docker local:  DATABASE_URL=postgresql://lupia:lupia@localhost:5433/lupia
#   RDS (AWS):     DATABASE_URL=postgresql://lupia:CLAVE@lupia-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/lupia
DATABASE_URL=
DB_PATH=lupia.db

# --- Brevo (correos de alertas) ---
# API key en: https://app.brevo.com/settings/keys/api
# CORREO_REMITENTE debe ser un remitente VERIFICADO en Brevo (Senders & IPs),
# si no, Brevo acepta el envio y lo rechaza en silencio despues.
# Si la cuenta restringe IPs (security/authorised_ips), desactivarlo o agregar la IP.
BREVO_API_KEY=
CORREO_REMITENTE=
NOMBRE_REMITENTE=LupIA

# --- Autenticacion ---
# Secreto para firmar los JWT. En produccion: cadena aleatoria larga (ej: openssl rand -hex 32)
JWT_SECRETO=lupia-dev-cambia-esto-en-produccion
JWT_HORAS=168
# Google SSO: ID de cliente OAuth (aplicacion web) de console.cloud.google.com
# APIs y servicios > Credenciales > Crear credencial > ID de cliente OAuth
GOOGLE_CLIENT_ID=

# --- IA: Claude ---
# IA_PROVEEDOR: "bedrock" (plan A) o "anthropic" (plan B con API key)
IA_PROVEEDOR=bedrock
AWS_REGION=us-east-1
# Requiere habilitar el modelo en Bedrock > Model access (consola AWS, us-east-1).
# Haiku 4.5 = el mas barato; para mejor prosa en el explicador: anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5
# Plan B: API key de console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-5
